# RADKit MCP Server Environment Configuration

# ============================================================================
# Direct RPC Connection (alternative to cloud-based connection)
# ============================================================================
# When RADKIT_DIRECT_HOST and RADKIT_DIRECT_TOKEN are both set, direct RPC
# mode is used and takes priority over all cloud-based auth modes.
# RADKIT_DEFAULT_SERVICE_SERIAL is not required in direct RPC mode.
# The E2EE validation token is obtained from the RADKit Web UI.

# RADKIT_DIRECT_HOST=192.168.1.100
# RADKIT_DIRECT_PORT=8181
# RADKIT_DIRECT_TOKEN=your-e2ee-validation-token

# ============================================================================
# RADKit Service Credentials
# ============================================================================

# User identity (email or username)
# RADKIT_IDENTITY=user@example.com

# Default service serial/code
# RADKIT_DEFAULT_SERVICE_SERIAL=your-service-serial

# Base64-encoded certificate credentials (for container deployment)
# RADKIT_CERT_B64=<base64-encoded-certificate>
# RADKIT_KEY_B64=<base64-encoded-private-key>
# RADKIT_CA_B64=<base64-encoded-ca-certificate>
# RADKIT_KEY_PASSWORD_B64=<base64-encoded-key-password>

# ============================================================================
# MCP Server Configuration
# ============================================================================

# Transport mode: stdio (default), sse, or https
MCP_TRANSPORT=stdio

# Host and port for SSE/HTTPS transport
# IMPORTANT: Default is 127.0.0.1 (localhost) for security reasons
# Only change to other addresses if you understand the security implications:
# - Binding to 0.0.0.0 exposes ALL MCP tools (including CLI command execution)
#   without authentication to anyone who can reach the port
# - Use firewall rules and network isolation to restrict access
# See SECURITY.md for detailed security guidance
MCP_HOST=127.0.0.1
MCP_PORT=3000

# ============================================================================
# Testing Configuration
# ============================================================================

# Device to use for integration tests
# RADKIT_TEST_DEVICE=router1

# Optional: Override test SNMP OID (default: 1.3.6.1.2.1.1.1.0 - sysDescr)
# RADKIT_TEST_SNMP_OID=1.3.6.1.2.1.1.1.0

# Optional: Override test command (default: show clock)
# RADKIT_TEST_COMMAND=show clock

# ============================================================================
# Legacy Environment Variables (Deprecated but still supported)
# ============================================================================

# RADKIT_SERVICE_USERNAME=user@example.com  # Use RADKIT_IDENTITY instead
# RADKIT_SERVICE_CODE=service-serial         # Use RADKIT_DEFAULT_SERVICE_SERIAL instead
# RADKIT_CLIENT_PRIVATE_KEY_PASSWORD_BASE64=password  # Use RADKIT_KEY_PASSWORD_B64 instead
